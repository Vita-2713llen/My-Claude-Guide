# OPTIONAL file. Copy it to .env (it is in .gitignore) only if you need to override something
# for yourself. Shared server addresses are in .deploy/environments.conf.

# A key other than ~/.ssh/id_ed25519:
# SSH_OPTS="-o ServerAliveInterval=30 -o StrictHostKeyChecking=accept-new -i ~/.ssh/cloudways_ed25519"

# Where to redirect emails from DEV (mu-plugin environment-guard) is set on the server in wp-config.php,
# not here.
